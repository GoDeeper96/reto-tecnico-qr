# Copie este archivo como .env (no se sube a git) y ejecute: npm install && npm run dev
#
# Opción A — probar contra las APIs desplegadas en AWS:
#   pegue en VITE_API_KEY la API key que recibió por correo.
VITE_API_GO_URL=https://s7lpc2bodl.execute-api.us-east-1.amazonaws.com/v1
VITE_API_NODE_URL=https://skaigmqxna.execute-api.us-east-1.amazonaws.com/v1
VITE_API_KEY=
#
# Opción B — probar contra las APIs en Docker (docker compose up --build):
#   use estas URLs y la API_KEY que definió en el .env de la raíz del repositorio.
# VITE_API_GO_URL=http://localhost:8080
# VITE_API_NODE_URL=http://localhost:3000
# VITE_API_KEY=
